# Copy this file to `.env` (next to docker-compose.yml) and fill in the values.
# Docker Compose reads this file for substitutions in docker-compose.yml.
# Only variables referenced by the service's environment block are passed in.
# Add other supported variables to that block when you need them.
# `.env` is gitignored; never commit real secrets.
# Full configuration guide: https://docs.cantinarr.com/install/configuration/

# Push is ENABLED by the gateway URL in docker-compose.yml (defaults to
# https://push.cantinarr.com). You normally set NOTHING here: with no API key the
# server auto-enrolls on first start and persists its own per-instance key in the
# DB. These are optional overrides:

# Pin a specific per-app key instead of auto-enrolling (rotate via the gateway:
# POST /v1/apps/<tenant>/rotate-key). Leave blank to auto-enroll.
CANTINARR_PUSH_API_KEY=

# Only if the gateway uses gated enrollment — the shared enroll token.
CANTINARR_PUSH_ENROLL_TOKEN=

# Optional gateway override. Unset uses the Compose example's community relay.
# Set CANTINARR_PUSH_GATEWAY_URL= with no value to disable push.
# CANTINARR_PUSH_GATEWAY_URL=https://push.cantinarr.com

# Optional completed-media downloads. Uncomment a matching read-only volume in
# docker-compose.yml and allowlist its Cantinarr-visible parent here. Then map
# each arr-reported path to a folder beneath this root in the instance editor.
# CANTINARR_MEDIA_ROOTS=/media
